{
  "name": "koppen-climate-lookup",
  "version": "2.0.0",
  "description": "Look up Koppen climate classifications by latitude and longitude",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "author": "Andrei Gec <@andreigec> (https://gec.dev/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreigec/koppen-climate-lookup.git"
  },
  "bugs": {
    "url": "https://github.com/andreigec/koppen-climate-lookup/issues"
  },
  "homepage": "https://github.com/andreigec/koppen-climate-lookup#readme",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "koppen",
    "climate",
    "classification",
    "geography",
    "weather"
  ],
  "devDependencies": {
    "@types/node": "^26.6.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
